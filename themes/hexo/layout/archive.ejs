<%
// =====================================================================
// @soul-blog/hexo — 归档页模板（路由 /archives/）
//
// 时间线的渲染与交互全部由 <archive-list> 组件承担（与 Hugo 主题同源），
// 模板只负责输出数据，不再服务端拼 HTML —— 归档的「年 → 月 → 文章」
// 分组规则因此只存在一份实现。
//
// 兼容：若站点额外装了 hexo-generator-archive，其 /archives/YYYY(/MM)
// 子页复用本布局，此时按年月过滤数据集。
// =====================================================================
var posts = site.posts ? site.posts.toArray() : []
var filterYear = page.year ? String(page.year) : ''
var filterMonth = page.month ? String(page.month).padStart(2, '0') : ''

if (filterYear || filterMonth) {
  posts = posts.filter(function (p) {
    if (!p.date) return false
    var y = typeof p.date.year === 'function' ? String(p.date.year()) : ''
    var m = typeof p.date.month === 'function' ? String(p.date.month() + 1).padStart(2, '0') : ''
    if (filterYear && y !== filterYear) return false
    if (filterMonth && m !== filterMonth) return false
    return true
  })
}
%>
<script id="site-data" type="application/json"><%- soul_site_data(posts) %></script>

<site-sidebar active-cat="archives"></site-sidebar>

<div class="flex min-w-0 flex-1 flex-col overflow-hidden">
  <archive-list></archive-list>
  <article-viewer>
    <span slot="page-views" id="vercount_value_page_pv" aria-label="本文阅读量">—</span>
  </article-viewer>
</div>
