<%
// 从 Hexo 站点数据构建 CATEGORIES 结构
var cats = [];
if (site.categories && site.categories.length) {
  site.categories.forEach(function(c) {
    cats.push({
      id: c.name.toLowerCase().replace(/\s+/g, '-'),
      name: c.name,
      en: c.slug || c.name,
      icon: '/images/extracted/home/iconfont-daima2@2x.png',
      w: 21,
      h: 21
    });
  });
}

// 从 Hexo 文章构建 ARTICLES 结构
var arts = [];
if (site.posts && site.posts.length) {
  site.posts.forEach(function(p) {
    arts.push({
      id: p._id || p.slug || p.title,
      cat: p.categories && p.categories.length ? p.categories[0].name.toLowerCase().replace(/\s+/g, '-') : 'uncategorized',
      title: p.title,
      cover: p.cover || p.thumbnail || '/images/extracted/home/图层_21@2x.png',
      summary: p.excerpt || p.description || p.content ? p.content.substring(0, 120) : '',
      date: p.date ? p.date.format('YYYY/MM/DD') : '',
      views: p.views || 0,
      commentCount: 0,
      paragraphs: p.content ? [p.content.substring(0, 200)] : []
    });
  });
}

var siteData = {
  articles: arts,
  categories: cats,
  icons: {
    home: '/images/extracted/home/iconfont-shouye@2x.png',
    eye: '/images/extracted/home/iconfont-icon01@2x.png',
    comment: '/images/extracted/home/iconfont-icon27@2x.png',
    calendar: '/images/extracted/home/iconfont-03(1)@2x.png',
    zan: '/images/extracted/article/iconfont-zan@2x.png',
    avatarA: '/images/extracted/article/4@2x.png',
    avatarB: '/images/extracted/article/20160126052324@2x.png'
  },
  siteName: config.title || 'CallMeSoul',
  icp: theme.icp || '',
  social: theme.social || []
};
%>
<script id="site-data" type="application/json"><%- JSON.stringify(siteData) %></script>

<site-sidebar active-cat="all"></site-sidebar>

<div class="flex min-w-0 flex-1 flex-col">
  <article-list active-cat="all"></article-list>
  <article-viewer></article-viewer>
</div>