{
  "name": "@soul-blog/wc",
  "version": "0.1.0",
  "description": "框架无关的 Web Components 组件库（soul-blog-theme 唯一 UI 真源）",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/components/*.ts",
    "**/components/index.ts"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.8.2",
    "vite": "^8.1.3",
    "vite-plugin-dts": "^4.5.0"
  }
}